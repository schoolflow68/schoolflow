def get_db():
    if "db" not in g:
        g.db = sqlite3.connect(DB_PATH, timeout=10)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys=ON")
    return g.db

@app.teardown_appcontext
def close_db(error=None):
    conn = g.pop("db", None)
    if conn is not None:
        conn.close()

def init_db():
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA foreign_keys=ON")
    conn.executescript("""
    CREATE TABLE IF NOT EXISTS users(
      id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL,
      password_hash TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS classes(
      id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT UNIQUE NOT NULL,
      room TEXT DEFAULT '', note TEXT DEFAULT ''
    );
    CREATE TABLE IF NOT EXISTS subjects(
      id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,
      code TEXT DEFAULT '', teacher TEXT DEFAULT '', UNIQUE(name,code)
    );
    CREATE TABLE IF NOT EXISTS students(
      id INTEGER PRIMARY KEY AUTOINCREMENT, student_code TEXT UNIQUE NOT NULL,
      full_name TEXT NOT NULL, class_id INTEGER REFERENCES classes(id) ON DELETE SET NULL,
      fingerprint_id INTEGER UNIQUE, active INTEGER NOT NULL DEFAULT 1, note TEXT DEFAULT ''
    );
    CREATE TABLE IF NOT EXISTS attendance(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      student_id INTEGER NOT NULL REFERENCES students(id) ON DELETE CASCADE,
      class_id INTEGER REFERENCES classes(id) ON DELETE SET NULL,
      subject_id INTEGER REFERENCES subjects(id) ON DELETE SET NULL,
      attendance_date TEXT NOT NULL, check_in TEXT, check_out TEXT,
      method TEXT NOT NULL DEFAULT 'manual',
      UNIQUE(student_id, attendance_date, subject_id)
    );
    """)
    if not conn.execute("SELECT id FROM users WHERE username='admin'").fetchone():
        conn.execute("INSERT INTO users(username,password_hash) VALUES(?,?)",
                     ("admin", generate_password_hash("ChangeMe123!")))
    conn.commit()
    conn.close()

def login_required(fn):
    @wraps(fn)
    def wrapped(*args, **kwargs):
        if not session.get("user_id"):
            return redirect(url_for("login"))
        return fn(*args, **kwargs)
    return wrapped

def current_day():
    return datetime.now().date().isoformat()

# R307S access is serialized so web requests cannot open the UART simultaneously.
def open_fingerprint():
    if PyFingerprint is None:
        raise RuntimeError("ไม่พบ pyfingerprint กรุณาติดตั้งใน school-venv ก่อน")
    finger = PyFingerprint(SERIAL_PORT, SERIAL_BAUD, 0xFFFFFFFF, 0x00000000)
    if not finger.verifyPassword():
        raise RuntimeError("รหัสผ่านเซนเซอร์ไม่ถูกต้อง")
    return finger

def test_sensor():
    with shared_sensor_lock:
        finger = open_fingerprint()
        return finger.getTemplateCount(), finger.getStorageCapacity()

def wait_for_finger(finger, prompt, timeout=25):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if finger.readImage():
            return
        time.sleep(0.15)
    raise RuntimeError(prompt + " หมดเวลา กรุณาลองใหม่")

def wait_for_removal(finger, timeout=15):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not finger.readImage():
            return
        time.sleep(0.15)
    raise RuntimeError("กรุณายกนิ้วออกจากเซนเซอร์แล้วลองใหม่")

