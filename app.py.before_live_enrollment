@app.route("/password", methods=["GET", "POST"])
@login_required
def password():
    if request.method == "POST":
        conn = get_db()
        user = conn.execute("SELECT * FROM users WHERE id=?", (session["user_id"],)).fetchone()
        old, new, confirm = request.form.get("old_password",""), request.form.get("new_password",""), request.form.get("confirm_password","")
        if not check_password_hash(user["password_hash"], old):
            flash("รหัสผ่านเดิมไม่ถูกต้อง", "error")
        elif len(new) < 10:
            flash("รหัสผ่านใหม่ต้องมีอย่างน้อย 10 ตัวอักษร", "error")
        elif new != confirm:
            flash("รหัสผ่านใหม่ไม่ตรงกัน", "error")
        else:
            conn.execute("UPDATE users SET password_hash=? WHERE id=?", (generate_password_hash(new), user["id"]))
            conn.commit()
            flash("เปลี่ยนรหัสผ่านแล้ว", "success")
            return redirect(url_for("dashboard"))
    return render_template("password.html")

