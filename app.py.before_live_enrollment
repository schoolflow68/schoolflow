@app.route("/students/<int:item_id>/fingerprint", methods=["POST"])
@login_required
def enroll_route(item_id):
    conn = get_db()
    student = conn.execute("SELECT * FROM students WHERE id=? AND active=1", (item_id,)).fetchone()
    if not student:
        flash("ไม่พบนักเรียนหรือบัญชีถูกปิดใช้งาน", "error")
    elif student["fingerprint_id"] is not None:
        flash("นักเรียนคนนี้มีหมายเลขลายนิ้วมือแล้ว เพื่อป้องกันการเขียนทับ กรุณาตรวจสอบก่อนลงทะเบียนใหม่", "error")
    else:
        try:
            # Hold the lock for the entire two-scan operation; only this request uses UART.
            with shared_sensor_lock:
                finger = open_fingerprint()
                flash("วางนิ้วของนักเรียนบนเซนเซอร์ภายใน 25 วินาที", "success")
                wait_for_finger(finger, "ไม่พบลายนิ้วมือครั้งที่ 1")
                finger.convertImage(0x01)
                wait_for_removal(finger)
                flash("ยกนิ้วแล้ว วางนิ้วเดิมซ้ำอีกครั้งภายใน 25 วินาที", "success")
                wait_for_finger(finger, "ไม่พบลายนิ้วมือครั้งที่ 2")
                finger.convertImage(0x02)
                finger.createTemplate()
                slot = finger.storeTemplate()
            conn.execute("UPDATE students SET fingerprint_id=? WHERE id=?", (int(slot), item_id))
            conn.commit()
            flash(f"ลงทะเบียนลายนิ้วมือสำเร็จ: {student['full_name']} (ช่อง {slot})", "success")
        except Exception as exc:
            conn.rollback()
            flash(f"ลงทะเบียนไม่สำเร็จ: {exc}", "error")
    return redirect(url_for("students"))

@app.route("/attendance", methods=["GET", "POST"])
@login_required
def attendance():
    conn = get_db()
    if request.method == "POST":
        student_id = request.form.get("student_id", type=int)
        subject_id = request.form.get("subject_id", type=int) or None
        mode = request.form.get("mode", "in")
        student = conn.execute("SELECT * FROM students WHERE id=? AND active=1", (student_id,)).fetchone()
        if not student:
            flash("ไม่พบนักเรียนที่ใช้งานอยู่", "error")
            return redirect(url_for("attendance"))
        day, clock = current_day(), datetime.now().strftime("%H:%M:%S")
        row = conn.execute("SELECT * FROM attendance WHERE student_id=? AND attendance_date=? AND subject_id IS ?",
                           (student_id, day, subject_id)).fetchone()
        if mode == "out":
            if not row or not row["check_in"]:
                flash("ยังไม่มีเวลาเข้าเรียนวันนี้", "error")
            elif row["check_out"]:
                flash("บันทึกเวลาออกแล้ว", "error")
            else:
                conn.execute("UPDATE attendance SET check_out=? WHERE id=?", (clock, row["id"]))
                conn.commit()
                flash(f"บันทึกเวลาออก {student['full_name']} เวลา {clock}", "success")
        elif row and row["check_in"]:
            flash("นักเรียนมีเวลาเข้าเรียนแล้ววันนี้", "error")
        else:
            if row:
                conn.execute("UPDATE attendance SET check_in=?,method='manual' WHERE id=?", (clock, row["id"]))
            else:
                conn.execute("""INSERT INTO attendance(student_id,class_id,subject_id,attendance_date,check_in,method)
                    VALUES(?,?,?,?,?,'manual')""", (student_id, student["class_id"], subject_id, day, clock))
            conn.commit()
            flash(f"บันทึกเวลาเข้า {student['full_name']} เวลา {clock}", "success")
        return redirect(url_for("attendance"))
    date = request.args.get("date", current_day())
    records = conn.execute("""SELECT a.*,s.student_code,s.full_name,c.name AS class_name,sub.name AS subject_name
        FROM attendance a JOIN students s ON s.id=a.student_id LEFT JOIN classes c ON c.id=a.class_id
        LEFT JOIN subjects sub ON sub.id=a.subject_id WHERE a.attendance_date=?
        ORDER BY a.check_in IS NULL,a.check_in DESC,s.full_name""", (date,)).fetchall()
    student_rows = conn.execute("SELECT * FROM students WHERE active=1 ORDER BY full_name").fetchall()
    subject_rows = conn.execute("SELECT * FROM subjects ORDER BY name").fetchall()
    return render_template("attendance.html", records=records, students=student_rows, subjects=subject_rows, selected_date=date)


@app.route("/fingerprint-scan", methods=["GET", "POST"])
@login_required
def fingerprint_scan():
    conn = get_db()
    result = None
    selected_subject = request.form.get("subject_id", "")
    selected_mode = request.form.get("mode", "in")

    if request.method == "POST":
        subject_id = request.form.get("subject_id", type=int) or None
        mode = request.form.get("mode", "in")
        if mode not in ("in", "out"):
            mode = "in"

        try:
            with shared_sensor_lock:
                finger = open_fingerprint()
                wait_for_finger(finger, "Place your finger on R307S", timeout=25)
                finger.convertImage(0x01)
                position, accuracy = finger.searchTemplate()

                try:
                    wait_for_removal(finger, timeout=10)
                except Exception:
                    pass

            if position < 0:
                result = ("error", "Fingerprint not registered. Enroll the student first.")
            else:
                student = conn.execute(
                    "SELECT * FROM students WHERE fingerprint_id=? AND active=1",
                    (int(position),)
                ).fetchone()

                if not student:
                    result = ("error", f"No active student assigned to slot {position}.")
                else:
                    day = current_day()
                    clock = datetime.now().strftime("%H:%M:%S")
                    row = conn.execute(
                        """SELECT * FROM attendance
                           WHERE student_id=? AND attendance_date=? AND subject_id IS ?""",
                        (student["id"], day, subject_id)
                    ).fetchone()

                    if mode == "out":
                        if not row or not row["check_in"]:
                            result = ("error", f"{student['full_name']} has no check-in record for this subject today.")
                        elif row["check_out"]:
                            result = ("error", f"{student['full_name']} already checked out at {row['check_out']}.")
                        else:
                            conn.execute(
                                "UPDATE attendance SET check_out=?, method='fingerprint' WHERE id=?",
                                (clock, row["id"])
                            )
                            conn.commit()
                            result = ("success", f"Check-out recorded: {student['full_name']} at {clock}")
                    elif row and row["check_in"]:
                        result = ("error", f"{student['full_name']} already checked in at {row['check_in']}.")
                    elif row:
                        conn.execute(
                            "UPDATE attendance SET check_in=?, method='fingerprint' WHERE id=?",
                            (clock, row["id"])
                        )
                        conn.commit()
                        result = ("success", f"Check-in recorded: {student['full_name']} at {clock}")
                    else:
                        conn.execute(
                            """INSERT INTO attendance
                               (student_id, class_id, subject_id, attendance_date, check_in, method)
                               VALUES (?, ?, ?, ?, ?, 'fingerprint')""",
                            (student["id"], student["class_id"], subject_id, day, clock)
                        )
                        conn.commit()
                        result = ("success", f"Check-in recorded: {student['full_name']} at {clock}")

        except Exception as exc:
            conn.rollback()
            result = ("error", f"Fingerprint scan failed: {exc}")

    subjects = conn.execute("SELECT * FROM subjects ORDER BY name").fetchall()
    conn.close()
    return render_template(
        "fingerprint_scan.html",
        subjects=subjects,
        result=result,
        selected_subject=selected_subject,
        selected_mode=selected_mode
    )


@app.route("/attendance/export")
@login_required
def export_attendance():
    date = request.args.get("date", current_day())
    rows = get_db().execute("""SELECT a.attendance_date,s.student_code,s.full_name,c.name,sub.name,
        a.check_in,a.check_out,a.method FROM attendance a JOIN students s ON s.id=a.student_id
        LEFT JOIN classes c ON c.id=a.class_id LEFT JOIN subjects sub ON sub.id=a.subject_id
        WHERE a.attendance_date=? ORDER BY c.name,s.full_name""", (date,)).fetchall()
    output = io.StringIO()
    writer = csv.writer(output)
    writer.writerow(["date","student_code","full_name","class","subject","check_in","check_out","method"])
    writer.writerows([tuple(r) for r in rows])
    response = make_response("\ufeff" + output.getvalue())
    response.headers["Content-Type"] = "text/csv; charset=utf-8"
    response.headers["Content-Disposition"] = f"attachment; filename=attendance-{date}.csv"
    return response

