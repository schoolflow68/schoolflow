import os
import sys
import time
import sqlite3
import fcntl
from datetime import datetime
from pyfingerprint.pyfingerprint import PyFingerprint

ROOT = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.environ.get("SCHOOL_DB_PATH", os.path.join(ROOT, "school.db"))
PORT = os.environ.get("R307S_PORT", "/dev/serial0")
BAUD = int(os.environ.get("R307S_BAUD", "57600"))
LOCK_PATH = "/tmp/school-r307s-shared.lock"
POLL_INTERVAL = 0.35


def close_finger(finger):
    if finger is not None:
        try:
            finger._PyFingerprint__serial.close()
        except Exception:
            pass


def record_attendance(slot):
    now = datetime.now()
    day = now.date().isoformat()
    clock = now.strftime("%H:%M:%S")
    with sqlite3.connect(DB_PATH, timeout=10) as db:
        db.row_factory = sqlite3.Row
        db.execute("PRAGMA foreign_keys=ON")
        student = db.execute(
            "SELECT * FROM students WHERE fingerprint_id=? AND active=1", (int(slot),)
        ).fetchone()
        if not student:
            print(f"Unknown/inactive fingerprint slot: {slot}", flush=True)
            return

        # Automatic daily attendance uses subject_id NULL, separate from subject-specific rows.
        row = db.execute(
            """SELECT * FROM attendance
               WHERE student_id=? AND attendance_date=? AND subject_id IS NULL
               ORDER BY id DESC LIMIT 1""",
            (student["id"], day),
        ).fetchone()

        if row is None:
            db.execute(
                """INSERT INTO attendance
                   (student_id,class_id,subject_id,attendance_date,check_in,method)
                   VALUES(?,?,NULL,?,?,'fingerprint')""",
                (student["id"], student["class_id"], day, clock),
            )
            print(f"CHECK-IN {student['full_name']} {clock}", flush=True)
        elif not row["check_out"]:
            db.execute(
                "UPDATE attendance SET check_out=?,method='fingerprint' WHERE id=?",
                (clock, row["id"]),
            )
            print(f"CHECK-OUT {student['full_name']} {clock}", flush=True)
        else:
            print(f"Already checked in and out today: {student['full_name']}", flush=True)
        db.commit()


def scan_poll():
    """One short sensor poll. Release shared lock immediately when no finger is present."""
    lock_file = open(LOCK_PATH, "a")
    finger = None
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        finger = PyFingerprint(PORT, BAUD, 0xFFFFFFFF, 0x00000000)
        if not finger.verifyPassword():
            raise RuntimeError("R307S password verification failed")
        if not finger.readImage():
            return False

        finger.convertImage(0x01)
        slot, accuracy = finger.searchTemplate()
        if slot < 0:
            print("Fingerprint not registered", flush=True)
        else:
            record_attendance(slot)

        # Debounce: retain sensor ownership until the finger is removed.
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            if not finger.readImage():
                break
            time.sleep(0.15)
        else:
            print("Finger removal timeout; waiting for removal before next scan", flush=True)
            # Do not allow a held finger to become a second attendance event.
            while True:
                try:
                    if not finger.readImage():
                        break
                except Exception:
                    break
                time.sleep(0.25)
        time.sleep(0.8)
        return True
    finally:
        close_finger(finger)
        try:
            fcntl.flock(lock_file, fcntl.LOCK_UN)
        finally:
            lock_file.close()


def main():
    print("R307S automatic attendance scanner starting", flush=True)
    while True:
        try:
            found = scan_poll()
            if not found:
                time.sleep(POLL_INTERVAL)
        except Exception as exc:
            print(f"Scanner error: {exc}", file=sys.stderr, flush=True)
            time.sleep(2)


if __name__ == "__main__":
    main()
