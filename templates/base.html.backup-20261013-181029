/* Apple-inspired visual refresh */
:root{
  --ink:#1d1d1f;--muted:#6e6e73;--line:#e8e8ed;--bg:#f5f5f7;
  --white:#fff;--nav:#fbfbfd;--nav2:#f2f2f7;--blue:#0071e3;
  --cyan:#06a7a0;--green:#16845b;--red:#d70015;
  --amber:#bf6b00;--shadow:0 4px 20px rgba(0,0,0,.045)
}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",
    "Noto Sans Thai",system-ui,sans-serif;
  letter-spacing:-.01em
}
.sidebar{
  background:rgba(251,251,253,.97);
  color:var(--ink);
  border-right:1px solid var(--line);
  box-shadow:none;
  backdrop-filter:blur(18px)
}
.brand{color:var(--ink)}
.brand small,.device span{color:var(--muted)}
.brandmark{border-radius:12px;box-shadow:none}
.navlabel{color:#86868b}
.navlinks a{color:#424245;border-radius:12px}
.navlinks a:hover,.navlinks a.active{
  color:var(--ink);background:#e8e8ed;box-shadow:none
}
.navlinks a.active{font-weight:750}
.sidebottom{border-top-color:#e8e8ed}
.device{background:#f5f5f7;border-color:#e8e8ed}
.device b{color:var(--ink)}
.mainarea{background:var(--bg)}
.topbar{
  background:rgba(255,255,255,.82);
  backdrop-filter:blur(18px);
  border-bottom-color:var(--line)
}
.card{
  border:1px solid rgba(0,0,0,.055);
  border-radius:20px;
  box-shadow:var(--shadow)
}
.statcard{transition:transform .18s ease,box-shadow .18s ease}
.statcard:hover{transform:translateY(-2px);box-shadow:0 9px 28px rgba(0,0,0,.07)}
button,.btn{
  background:var(--blue);
  border-radius:12px;
  transition:background .16s ease,transform .16s ease,box-shadow .16s ease
}
button:hover,.btn:hover{filter:none;background:#0077ed;box-shadow:0 4px 12px #0071e322}
button.secondary,.btn.secondary{background:#f0f0f5;color:#06c}
button.secondary:hover,.btn.secondary:hover{background:#e5e5ea}
input,select{
  border-color:#d2d2d7;
  border-radius:12px;
  min-height:44px
}
input:focus,select:focus{
  border-color:#0071e3;
  box-shadow:0 0 0 4px rgba(0,113,227,.13)
}
.tablewrap{border-color:var(--line);border-radius:15px}
th{background:#f5f5f7;color:#6e6e73}
tbody tr:hover{background:#fafafd}
.flash{border-radius:13px}
@media(max-width:720px){
  .sidebar{background:#fbfbfd;border-bottom:1px solid var(--line)}
  .navlinks a.active{background:#e8e8ed;color:var(--ink)}
}


/* APPLE_STORE_STYLE_NAV */
.shell{min-height:100vh}
.sidebar{
  position:sticky;inset:auto;top:0;width:100%;height:58px;
  overflow:visible;padding:0 max(22px,calc((100vw - 1440px)/2));
  display:flex;flex-direction:row;align-items:center;gap:20px;
  color:#1d1d1f;background:rgba(250,250,252,.88);
  border:0;border-bottom:1px solid rgba(0,0,0,.09);
  box-shadow:none;backdrop-filter:blur(22px);z-index:20
}
.brand{flex:none;padding:0;color:#1d1d1f;font-size:15px;gap:9px}
.brandmark{width:30px;height:30px;border-radius:9px;box-shadow:none}
.brand small{font-size:8px;letter-spacing:1.2px}
.navlabel,.sidebottom{display:none!important}
.sidebar .navlinks{
  display:flex;align-items:center;gap:3px;min-width:0;
  overflow-x:auto;scrollbar-width:none
}
.sidebar .navlinks::-webkit-scrollbar{display:none}
.sidebar .navlinks a{
  min-height:34px;padding:7px 9px;gap:6px;border-radius:8px;
  color:#424245;font-size:11px;font-weight:500;white-space:nowrap
}
.sidebar .navlinks a .ico{width:auto;font-size:13px;color:#6e6e73}
.sidebar .navlinks a:hover{background:#ededf0;color:#1d1d1f}
.sidebar .navlinks a.active{background:#e8f2ff;color:#0066cc}
.sidebar nav.navlinks:nth-of-type(2){margin-left:auto;flex:none}
.mainarea{margin-left:0;min-height:calc(100vh - 58px)}
.topbar{
  position:sticky;top:58px;height:58px;padding:0 max(28px,calc((100vw - 1360px)/2));
  background:rgba(255,255,255,.9);backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(0,0,0,.06);z-index:10
}
main{max-width:1440px;padding:46px 42px 58px}
.pagehead{align-items:center;margin-bottom:34px}
.pagehead h1{font-size:42px;letter-spacing:-1.5px;font-weight:720}
.pagehead p{font-size:15px}
.eyebrow{font-size:11px;letter-spacing:1.1px}
.card{
  padding:30px;border:1px solid rgba(0,0,0,.055);
  border-radius:24px;box-shadow:0 4px 20px rgba(0,0,0,.035)
}
.card h2{font-size:19px;letter-spacing:-.4px}
.grid{gap:18px}
.statcard{padding:25px;border-radius:22px}
.stat{font-size:40px;letter-spacing:-1.8px}
button,.btn{border-radius:20px;padding:11px 18px;font-size:13px}
button.secondary,.btn.secondary{background:#f0f0f5;color:#06c}
input,select{min-height:48px;border-radius:13px}
.tablewrap{border-radius:17px}
th,td{padding:16px}
.loginpage{margin:0}
footer{padding:22px}
@media(max-width:1000px){
  .sidebar{gap:12px;padding:0 14px}
  .brand small{display:none}
  .sidebar .navlinks a{padding:7px;font-size:10px}
  main{padding:34px 24px 46px}
  .pagehead h1{font-size:35px}
}
@media(max-width:720px){
  .sidebar{height:auto;min-height:54px;position:sticky;display:block;padding:9px 12px}
  .brand{padding:0 4px 8px}
  .sidebar .navlinks{gap:3px}
  .sidebar .navlinks a{font-size:10px;padding:8px}
  .sidebar nav.navlinks:nth-of-type(2){margin-left:0}
  .topbar{top:54px;height:52px;padding:0 15px}
  main{padding:26px 14px 38px}
  .pagehead h1{font-size:30px}
  .card{padding:19px;border-radius:19px}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .statcard{padding:16px}
  .stat{font-size:30px}
}

</style></head>
<body>
{% if session.get('user_id') %}
<div class="shell"><aside class="sidebar"><div class="brand"><div class="brandmark">✦</div><div>SchoolFlow<small>ATTENDANCE SUITE</small></div></div><div class="navlabel">Workspace</div><nav class="navlinks">
<a class="{% if request.endpoint=='dashboard' %}active{% endif %}" href="{{ url_for('dashboard') }}"><span class="ico">▦</span> ภาพรวมระบบ</a>
<a class="{% if request.endpoint in ['classes','delete_class'] %}active{% endif %}" href="{{ url_for('classes') }}"><span class="ico">▤</span> ชั้นเรียน</a>
<a class="{% if request.endpoint in ['subjects','delete_subject'] %}active{% endif %}" href="{{ url_for('subjects') }}"><span class="ico">▧</span> รายวิชา</a>
<a class="{% if request.endpoint in ['students','toggle_student','delete_student','enroll_route'] %}active{% endif %}" href="{{ url_for('students') }}"><span class="ico">♙</span> นักเรียน</a>
<a class="{% if request.endpoint in ['attendance','export_attendance'] %}active{% endif %}" href="{{ url_for('attendance') }}"><span class="ico">◷</span> ประวัติเข้า–ออก</a>
<a class="{% if request.endpoint=='fingerprint_scan' %}active{% endif %}" href="{{ url_for('fingerprint_scan') }}"><span class="ico">◎</span> สแกนลายนิ้วมือ</a>
<a class="{% if request.endpoint=='sensor' %}active{% endif %}" href="{{ url_for('sensor') }}"><span class="ico">⌁</span> อุปกรณ์ R307S</a>
</nav><div class="navlabel" style="margin-top:19px">Settings</div><nav class="navlinks"><a class="{% if request.endpoint=='password' %}active{% endif %}" href="{{ url_for('password') }}"><span class="ico">⚙</span> ตั้งค่าบัญชี</a><a href="{{ url_for('logout') }}"><span class="ico">↪</span> ออกจากระบบ</a></nav><div class="sidebottom"><div class="device"><span class="dot"></span><div><b>Raspberry Pi 4</b><span>Fingerprint station · R307S</span></div></div></div></aside>
<div class="mainarea"><div class="topbar"><div><div class="crumb">WORKSPACE / {% block crumb %}OVERVIEW{% endblock %}</div><div class="welcome">ระบบจัดการการเข้าเรียน</div></div><div class="userbox"><div class="usertext"><b>{{ session.get('username','ผู้ดูแลระบบ') }}</b><small>Administrator</small></div><div class="avatar">{{ (session.get('username','A')[:1])|upper }}</div></div></div><main>{% for category,message in get_flashed_messages(with_categories=true) %}<div class="flash {{ 'error' if category=='error' else '' }}">{{ message }}</div>{% endfor %}{% block content %}{% endblock %}</main><footer>SchoolFlow · Flask + SQLite · Raspberry Pi 4</footer></div></div>
{% else %}<div class="loginpage"><main style="width:100%;max-width:480px;padding:0">{% for category,message in get_flashed_messages(with_categories=true) %}<div class="flash {{ 'error' if category=='error' else '' }}">{{ message }}</div>{% endfor %}{{ self.content() }}</main></div>{% endif %}
</body></html>
