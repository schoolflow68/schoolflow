{% extends "base.html" %}{% block content %}<h1>บันทึกเวลาเข้า–ออก</h1><p class="muted">บันทึกด้วยตนเองได้ระหว่างเตรียมเซนเซอร์</p><div class="card"><form method="post" class="row"><div class="field"><label>นักเรียน *</label><select name="student_id" required><option value="">เลือกนักเรียน</option>{% for s in students %}<option value="{{ s.id }}">{{ s.student_code }} · {{ s.full_name }}</option>{% endfor %}</select></div><div class="field"><label>รายวิชา</label><select name="subject_id"><option value="">ไม่ระบุวิชา</option>{% for s in subjects %}<option value="{{ s.id }}">{{ s.name }}</option>{% endfor %}</select></div><div class="field"><label>ประเภท</label><select name="mode"><option value="in">เวลาเข้า</option><option value="out">เวลาออก</option></select></div><button>บันทึกเวลา</button></form></div><div class="card"><div class="row" style="justify-content:space-between"><h2>ประวัติวันที่ {{ selected_date }}</h2><div class="actions"><form method="get" class="row"><input type="date" name="date" value="{{ selected_date }}"><button class="secondary">ค้นหา</button></form><a class="btn" href="{{ url_for('export_attendance',date=selected_date) }}">ส่งออก CSV</a></div></div><div class="tablewrap"><table><tr><th>รหัส</th><th>ชื่อ</th><th>ชั้น</th><th>วิชา</th><th>เข้า</th><th>ออก</th><th>วิธี</th></tr>{% for r in records %}<tr><td>{{ r.student_code }}</td><td>{{ r.full_name }}</td><td>{{ r.class_name or '-' }}</td><td>{{ r.subject_name or '-' }}</td><td>{{ r.check_in or '-' }}</td><td>{{ r.check_out or '-' }}</td><td>{{ r.method }}</td></tr>{% else %}<tr><td colspan="7">ไม่มีข้อมูลในวันที่เลือก</td></tr>{% endfor %}</table></div></div>{% endblock %}
