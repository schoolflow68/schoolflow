<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}School Check-in{% endblock %}</title>
<style>
:root{--navy:#142542;--blue:#2563eb;--bg:#f4f7fb;--line:#e1e7f0;--muted:#667085;--red:#b42318}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,"Noto Sans Thai",sans-serif;color:#172033}header{background:var(--navy);color:white;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.brand{font-weight:800;font-size:18px}nav{display:flex;gap:5px;flex-wrap:wrap}nav a{color:#e6edff;text-decoration:none;padding:8px 10px;border-radius:7px;font-size:14px}nav a:hover{background:#2c4060}main{max-width:1200px;margin:24px auto;padding:0 14px}h1{font-size:25px;margin:0 0 5px}h2{font-size:18px;margin:0 0 13px}.muted{color:var(--muted);font-size:13px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px;margin-bottom:16px;box-shadow:0 3px 12px #14254208}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.stat{font-size:32px;color:var(--blue);font-weight:800}.row{display:flex;align-items:end;gap:12px;flex-wrap:wrap}.field{display:flex;flex-direction:column;gap:5px;flex:1;min-width:145px}label{font-size:13px;font-weight:650}input,select{font:inherit;padding:10px;border:1px solid #ccd5e3;border-radius:8px;width:100%;background:#fff}button,.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;padding:10px 13px;background:var(--blue);color:white;font:inherit;font-weight:650;text-decoration:none;cursor:pointer}button.secondary{background:#eaf0fa;color:#253653}button.danger{background:#fff0ee;color:var(--red)}button.success{background:#138a5b}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:middle}th{font-size:12px;color:var(--muted);background:#f8fafc}.tablewrap{overflow:auto}.flash{padding:12px;border-radius:8px;margin-bottom:14px;background:#e5f6ed;color:#12603e}.flash.error{background:#fff0ee;color:#9d2017}.actions{display:flex;gap:5px;flex-wrap:wrap}.loginbox{max-width:440px;margin:8vh auto}.small{font-size:12px}footer{text-align:center;color:var(--muted);font-size:12px;padding:25px}@media(max-width:600px){main{margin:15px auto}h1{font-size:22px}}
</style></head><body>{% if session.get('user_id') %}<header><div class="brand">🎓 School Check-in</div><nav><a href="{{ url_for('dashboard') }}">ภาพรวม</a><a href="{{ url_for('classes') }}">ชั้นเรียน</a><a href="{{ url_for('subjects') }}">รายวิชา</a><a href="{{ url_for('students') }}">นักเรียน</a><a href="{{ url_for('attendance') }}">เข้า–ออก</a><a href="{{ url_for('sensor') }}">R307S</a><a href="{{ url_for('password') }}">รหัสผ่าน</a><a href="{{ url_for('logout') }}">ออกจากระบบ</a></nav></header>{% endif %}
<main>{% for category,message in get_flashed_messages(with_categories=true) %}<div class="flash {{ 'error' if category=='error' else '' }}">{{ message }}</div>{% endfor %}{% block content %}{% endblock %}</main><footer>School Check-in · Raspberry Pi 4 · Flask + SQLite</footer></body></html>
