{% extends "base.html" %}{% block content %}<h1>จัดการชั้นเรียน</h1><p class="muted">เพิ่มชั้นเรียน ห้องเรียน และหมายเหตุ</p><div class="card"><form method="post" class="row"><div class="field"><label>ชื่อชั้นเรียน *</label><input name="name" placeholder="เช่น ม.1/1" required></div><div class="field"><label>ห้อง</label><input name="room"></div><div class="field"><label>หมายเหตุ</label><input name="note"></div><button>เพิ่มชั้นเรียน</button></form></div><div class="card"><div class="tablewrap"><table><tr><th>ชั้นเรียน</th><th>ห้อง</th><th>นักเรียน</th><th>หมายเหตุ</th><th></th></tr>{% for r in rows %}<tr><td>{{ r.name }}</td><td>{{ r.room or '-' }}</td><td>{{ r.total }}</td><td>{{ r.note or '-' }}</td><td><form method="post" action="{{ url_for('delete_class',item_id=r.id) }}" onsubmit="return confirm('ลบชั้นเรียนนี้?')"><button class="danger">ลบ</button></form></td></tr>{% else %}<tr><td colspan="5">ยังไม่มีชั้นเรียน</td></tr>{% endfor %}</table></div></div>{% endblock %}
