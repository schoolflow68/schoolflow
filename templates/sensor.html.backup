{% extends "base.html" %}{% block content %}<h1>เซนเซอร์ R307S</h1><p class="muted">ทดสอบ UART ก่อนเปิดใช้ลงทะเบียนลายนิ้วมือ</p><div class="card"><p>พอร์ต: <b>{{ port }}</b></p><p>Baud rate: <b>{{ baud }}</b></p><p>pyserial: <b>{{ 'พร้อม' if serial_installed else 'ยังไม่ได้ติดตั้ง' }}</b></p><form method="post"><button>ทดสอบการเชื่อมต่อ</button></form>{% if result %}<div class="flash {{ 'error' if result[0]=='error' else '' }}" style="margin-top:14px">{{ result[1] }}</div>{% endif %}</div><div class="card"><h2>การต่อสาย UART</h2><ul><li>R307S TX → Pi GPIO15/RX ขาจริง 10</li><li>R307S RX → Pi GPIO14/TX ขาจริง 8</li><li>GND ร่วมกัน เช่น ขา 6</li></ul><p class="muted">ตรวจแรงดันสัญญาณก่อนต่อ ห้ามป้อนสัญญาณ UART 5V เข้าขา GPIO โดยตรง</p></div>{% endblock %}
