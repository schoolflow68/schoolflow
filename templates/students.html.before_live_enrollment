{% extends "base.html" %}{% block content %}<h1>จัดการนักเรียน</h1><p class="muted">เพิ่มรายชื่อ กำหนดชั้นเรียน และจัดการสถานะ</p><div class="card"><form method="post" class="row"><div class="field"><label>รหัสนักเรียน *</label><input name="student_code" required></div><div class="field"><label>ชื่อ–นามสกุล *</label><input name="full_name" required></div><div class="field"><label>ชั้นเรียน</label><select name="class_id"><option value="">ไม่ระบุ</option>{% for c in classes %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></div><div class="field"><label>หมายเหตุ</label><input name="note"></div><button>เพิ่มนักเรียน</button></form></div><div class="card"><div class="tablewrap"><table><tr><th>รหัส</th><th>ชื่อ</th><th>ชั้น</th><th>ช่องนิ้ว</th><th>สถานะ</th><th>จัดการ</th></tr>{% for s in rows %}<tr style="{{ 'opacity:.55' if not s.active else '' }}"><td>{{ s.student_code }}</td><td>{{ s.full_name }}</td><td>{{ s.class_name or '-' }}</td><td>{{ s.fingerprint_id or 'ยังไม่ลงทะเบียน' }}</td><td>{{ 'ใช้งาน' if s.active else 'ปิดใช้งาน' }}</td><td><div class="actions"><form method="post" action="{{ url_for('enroll_route',item_id=s.id) }}"><button class="success" {% if not s.active %}disabled{% endif %}>ลงทะเบียนนิ้ว*</button></form><form method="post" action="{{ url_for('toggle_student',item_id=s.id) }}"><button class="secondary">{{ 'ปิดใช้' if s.active else 'เปิดใช้' }}</button></form><form method="post" action="{{ url_for('delete_student',item_id=s.id) }}" onsubmit="return confirm('ลบนักเรียนและประวัติ?')"><button class="danger">ลบ</button></form></div></td></tr>{% else %}<tr><td colspan="6">ยังไม่มีนักเรียน</td></tr>{% endfor %}</table></div><p class="muted">*ปุ่มลงทะเบียนนิ้วจะยังไม่เขียนข้อมูลลงเซนเซอร์ จนกว่าการทดสอบ UART จะผ่านและยืนยันขั้นตอนกับรุ่น R307S ของคุณ</p></div>{% endblock %}
