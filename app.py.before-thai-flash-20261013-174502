@app.route("/students/<int:item_id>/delete", methods=["POST"])
@login_required
def delete_student(item_id):
    conn = get_db()
    student = conn.execute(
        "SELECT id, full_name, fingerprint_id FROM students WHERE id=?",
        (item_id,),
    ).fetchone()

    if not student:
        flash("Student not found", "error")
        return redirect(url_for("students"))

    slot = student["fingerprint_id"]
    if slot is not None:
        finger = None
        try:
            with shared_sensor_lock:
                finger = open_fingerprint()
                deleted = finger.deleteTemplate(int(slot))
                if not deleted:
                    raise RuntimeError("Sensor did not confirm template deletion")
        except Exception as exc:
            flash(
                f"Could not delete sensor slot {slot}; student record was kept: {exc}",
                "error",
            )
            return redirect(url_for("students"))
        finally:
            if finger is not None:
                try:
                    finger._PyFingerprint__serial.close()
                except Exception:
                    pass

    conn.execute("DELETE FROM students WHERE id=?", (item_id,))
    conn.commit()
    flash("Student and fingerprint template deleted", "success")
    return redirect(url_for("students"))


ENROLL_JOBS = {}
ENROLL_JOBS_LOCK = threading.Lock()


def set_enroll_job(job_id, state, message):
    with ENROLL_JOBS_LOCK:
        ENROLL_JOBS[job_id] = {"state": state, "message": message}


def enroll_worker(item_id, job_id):
    db = sqlite3.connect(DB_PATH, timeout=10)
    finger = None
    stored_slot = None
    try:
        student = db.execute(
            "SELECT full_name FROM students WHERE id=? AND active=1 "
            "AND fingerprint_id IS NULL",
            (item_id,),
        ).fetchone()
        if not student:
            raise RuntimeError("Student not found, inactive, or already enrolled")

        student_name = student[0]
        with shared_sensor_lock:
            finger = open_fingerprint()

            set_enroll_job(
                job_id, "running",
                "\u0e27\u0e32\u0e07\u0e19\u0e34\u0e49\u0e27\u0e1a\u0e19\u0e40\u0e0b\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c \u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48 1"
            )
            wait_for_finger(finger, "First finger scan timed out", timeout=25)
            finger.convertImage(0x01)

            position, accuracy = finger.searchTemplate()
            if position >= 0:
                raise RuntimeError(
                    f"Fingerprint already exists in sensor slot {position}"
                )

            set_enroll_job(
                job_id, "running",
                "\u0e22\u0e01\u0e19\u0e34\u0e49\u0e27\u0e2d\u0e2d\u0e01 \u0e41\u0e25\u0e49\u0e27\u0e27\u0e32\u0e07\u0e19\u0e34\u0e49\u0e27\u0e40\u0e14\u0e34\u0e21\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07"
            )
            wait_for_removal(finger)

            set_enroll_job(
                job_id, "running",
                "\u0e27\u0e32\u0e07\u0e19\u0e34\u0e49\u0e27\u0e40\u0e14\u0e34\u0e21\u0e1a\u0e19\u0e40\u0e0b\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c \u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48 2"
            )
            wait_for_finger(finger, "Second finger scan timed out", timeout=25)
            finger.convertImage(0x02)
            finger.createTemplate()
            stored_slot = int(finger.storeTemplate())

            try:
                result = db.execute(
                    "UPDATE students SET fingerprint_id=? "
                    "WHERE id=? AND active=1 AND fingerprint_id IS NULL",
                    (stored_slot, item_id),
                )
                if result.rowcount != 1:
                    raise RuntimeError("Student record changed during enrollment")
                db.commit()
            except Exception:
                db.rollback()
                finger.deleteTemplate(stored_slot)
                stored_slot = None
                raise

        set_enroll_job(
            job_id, "success",
            f"\u0e25\u0e07\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08: {student_name} (slot {stored_slot})"
        )
    except Exception as exc:
        db.rollback()
        set_enroll_job(
            job_id, "error",
            "\u0e25\u0e07\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e44\u0e21\u0e48\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08: " + str(exc)
        )
    finally:
        if finger is not None:
            try:
                finger._PyFingerprint__serial.close()
            except Exception:
                pass
        db.close()


