SENSOR_LOCK = threading.Lock()
SENSOR_LOCK_PATH = "/tmp/school-r307s-shared.lock"

class SharedSensorLock:
    def __enter__(self):
        import fcntl
        SENSOR_LOCK.acquire()
        self.file = open(SENSOR_LOCK_PATH, "w")
        try:
            fcntl.flock(self.file, fcntl.LOCK_EX)
        except Exception:
            self.file.close()
            SENSOR_LOCK.release()
            raise
        return self

    def __exit__(self, exc_type, exc, tb):
        import fcntl
        try:
            fcntl.flock(self.file, fcntl.LOCK_UN)
            self.file.close()
        finally:
            SENSOR_LOCK.release()

shared_sensor_lock = SharedSensorLock()

