@app.route("/class-scan-poll", methods=["POST"])
@login_required
def class_scan_poll():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS scanner_settings (
            setting_key TEXT PRIMARY KEY,
            setting_value TEXT NOT NULL
        )
    """)
    conn.commit()

    settings = {
        row["setting_key"]: row["setting_value"]
        for row in conn.execute(
            "SELECT setting_key, setting_value FROM scanner_settings"
        ).fetchall()
    }
    subject_id = settings.get("active_subject_id")
    phase = settings.get("scan_phase")
    if not subject_id or phase not in ("in", "out"):
        return jsonify({"state": "idle", "message": "????????????????????"})

    finger = None
    result = {"state": "waiting", "message": "\u0e01\u0e33\u0e25\u0e31\u0e07\u0e23\u0e2d\u0e2a\u0e41\u0e01\u0e19 \u0e27\u0e32\u0e07\u0e19\u0e34\u0e49\u0e27\u0e1a\u0e19\u0e40\u0e0b\u0e47\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c"}
    try:
        with shared_sensor_lock:
            finger = open_fingerprint()
            if not finger.readImage():
                return jsonify(result)

            finger.convertImage(0x01)
            position, accuracy = finger.searchTemplate()

            if position < 0:
                result = {
                    "state": "error",
                    "message": "\u0e44\u0e21\u0e48\u0e1e\u0e1a\u0e25\u0e32\u0e22\u0e19\u0e34\u0e49\u0e27\u0e19\u0e35\u0e49\u0e43\u0e19\u0e23\u0e30\u0e1a\u0e1a",
                }
            else:
                student = conn.execute(
                    "SELECT * FROM students WHERE fingerprint_id=? AND active=1",
                    (int(position),),
                ).fetchone()
                subject = conn.execute(
                    "SELECT name FROM subjects WHERE id=?", (int(subject_id),)
                ).fetchone()

                if not student or not subject:
                    result = {
                        "state": "error",
                        "message": "\u0e44\u0e21\u0e48\u0e1e\u0e1a\u0e19\u0e31\u0e01\u0e40\u0e23\u0e35\u0e22\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e27\u0e34\u0e0a\u0e32",
                    }
                else:
                    columns = {
                        row["name"]
                        for row in conn.execute("PRAGMA table_info(attendance)")
                    }
                    if "attendance_status" not in columns:
                        conn.execute(
                            "ALTER TABLE attendance ADD COLUMN attendance_status "
                            "TEXT NOT NULL DEFAULT 'present'"
                        )

                    now = datetime.now()
                    day = now.date().isoformat()
                    clock = now.strftime("%H:%M:%S")
                    row = conn.execute(
                        """SELECT * FROM attendance
                           WHERE student_id=? AND attendance_date=? AND subject_id=?
                           ORDER BY id DESC LIMIT 1""",
                        (student["id"], day, int(subject_id)),
                    ).fetchone()

                    if phase == "in":
                        if row and row["check_in"]:
                            result = {
                                "state": "info",
                                "message": f"\u0e40\u0e02\u0e49\u0e32\u0e40\u0e23\u0e35\u0e22\u0e19\u0e41\u0e25\u0e49\u0e27: {student['full_name']}",
                            }
                        else:
                            try:
                                parts = settings["class_start_time"].split(":")
                                grace = int(settings["late_grace_minutes"])
                                start_minutes = int(parts[0]) * 60 + int(parts[1])
                                current_minutes = now.hour * 60 + now.minute
                                status = (
                                    "late"
                                    if current_minutes > start_minutes + grace
                                    else "present"
                                )
                            except (KeyError, ValueError, IndexError):
                                result = {
                                    "state": "error",
                                    "message": "\u0e15\u0e31\u0e49\u0e07\u0e40\u0e27\u0e25\u0e32\u0e04\u0e32\u0e1a\u0e2b\u0e23\u0e37\u0e2d\u0e19\u0e32\u0e17\u0e35\u0e1c\u0e48\u0e2d\u0e19\u0e1c\u0e31\u0e19\u0e44\u0e21\u0e48\u0e16\u0e39\u0e01\u0e15\u0e49\u0e2d\u0e07",
                                }
                                status = None

                            if status:
                                if row:
                                    conn.execute(
                                        """UPDATE attendance SET check_in=?,
                                           method='fingerprint', attendance_status=?
                                           WHERE id=?""",
                                        (clock, status, row["id"]),
                                    )
                                else:
                                    conn.execute(
                                        """INSERT INTO attendance
                                           (student_id,class_id,subject_id,attendance_date,
                                            check_in,method,attendance_status)
                                           VALUES(?,?,?,?,?,'fingerprint',?)""",
                                        (
                                            student["id"], student["class_id"],
                                            int(subject_id), day, clock, status,
                                        ),
                                    )
                                conn.commit()
                                label = "\u0e2a\u0e32\u0e22" if status == "late" else "\u0e15\u0e23\u0e07\u0e40\u0e27\u0e25\u0e32"
                                result = {
                                    "state": "success",
                                    "message": f"\u0e40\u0e02\u0e49\u0e32\u0e40\u0e23\u0e35\u0e22\u0e19: {student['full_name']} · {subject['name']} · {clock} · {label}",
                                }

                    elif phase == "out":
                        if not row or not row["check_in"]:
                            result = {
                                "state": "error",
                                "message": f"\u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e21\u0e35\u0e40\u0e27\u0e25\u0e32\u0e40\u0e02\u0e49\u0e32: {student['full_name']}",
                            }
                        elif row["check_out"]:
                            result = {
                                "state": "info",
                                "message": f"\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e2d\u0e2d\u0e01\u0e41\u0e25\u0e49\u0e27: {student['full_name']}",
                            }
                        else:
                            conn.execute(
                                """UPDATE attendance SET check_out=?, method='fingerprint'
                                   WHERE id=?""",
                                (clock, row["id"]),
                            )
                            conn.commit()
                            result = {
                                "state": "success",
                                "message": f"\u0e2d\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e04\u0e32\u0e1a: {student['full_name']} · {subject['name']} · {clock}",
                            }

            # Wait for the finger to be lifted before allowing the next scan.
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                if not finger.readImage():
                    break
                time.sleep(0.15)
            else:
                while finger.readImage():
                    time.sleep(0.25)

        return jsonify(result)
    except Exception as exc:
        conn.rollback()
        return jsonify({
            "state": "error",
            "message": "\u0e2a\u0e41\u0e01\u0e19\u0e44\u0e21\u0e48\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08: " + str(exc),
        }), 500
    finally:
        if finger is not None:
            try:
                finger._PyFingerprint__serial.close()
            except Exception:
                pass


@app.route("/fingerprint-scan", methods=["GET", "POST"])
@login_required
def fingerprint_scan():
    conn = get_db()
    result = None
    selected_subject = request.form.get("subject_id", "")
    selected_mode = request.form.get("mode", "in")

    if request.method == "POST":
        subject_id = request.form.get("subject_id", type=int) or None
        mode = request.form.get("mode", "in")
        if mode not in ("in", "out"):
            mode = "in"

        try:
            with shared_sensor_lock:
                finger = open_fingerprint()
                wait_for_finger(finger, "Place your finger on R307S", timeout=25)
                finger.convertImage(0x01)
                position, accuracy = finger.searchTemplate()

                try:
                    wait_for_removal(finger, timeout=10)
                except Exception:
                    pass

            if position < 0:
                result = ("error", "Fingerprint not registered. Enroll the student first.")
            else:
                student = conn.execute(
                    "SELECT * FROM students WHERE fingerprint_id=? AND active=1",
                    (int(position),)
                ).fetchone()

                if not student:
                    result = ("error", f"No active student assigned to slot {position}.")
                else:
                    day = current_day()
                    clock = datetime.now().strftime("%H:%M:%S")
                    row = conn.execute(
                        """SELECT * FROM attendance
                           WHERE student_id=? AND attendance_date=? AND subject_id IS ?""",
                        (student["id"], day, subject_id)
                    ).fetchone()

                    if mode == "out":
                        if not row or not row["check_in"]:
                            result = ("error", f"{student['full_name']} has no check-in record for this subject today.")
                        elif row["check_out"]:
                            result = ("error", f"{student['full_name']} already checked out at {row['check_out']}.")
                        else:
                            conn.execute(
                                "UPDATE attendance SET check_out=?, method='fingerprint' WHERE id=?",
                                (clock, row["id"])
                            )
                            conn.commit()
                            result = ("success", f"Check-out recorded: {student['full_name']} at {clock}")
                    elif row and row["check_in"]:
                        result = ("error", f"{student['full_name']} already checked in at {row['check_in']}.")
                    elif row:
                        conn.execute(
                            "UPDATE attendance SET check_in=?, method='fingerprint' WHERE id=?",
                            (clock, row["id"])
                        )
                        conn.commit()
                        result = ("success", f"Check-in recorded: {student['full_name']} at {clock}")
                    else:
                        conn.execute(
                            """INSERT INTO attendance
                               (student_id, class_id, subject_id, attendance_date, check_in, method)
                               VALUES (?, ?, ?, ?, ?, 'fingerprint')""",
                            (student["id"], student["class_id"], subject_id, day, clock)
                        )
                        conn.commit()
                        result = ("success", f"Check-in recorded: {student['full_name']} at {clock}")

        except Exception as exc:
            conn.rollback()
            result = ("error", f"Fingerprint scan failed: {exc}")

    subjects = conn.execute("SELECT * FROM subjects ORDER BY name").fetchall()
    conn.close()
    return render_template(
        "fingerprint_scan.html",
        subjects=subjects,
        result=result,
        selected_subject=selected_subject,
        selected_mode=selected_mode
    )


